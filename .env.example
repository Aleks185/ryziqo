# #InvestWatch — konfiguracja środowiska (bez sekretów w repozytorium)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Port panelu (docker compose: Nginx z frontendem -> http://localhost:3000)
FRONTEND_PORT=3000

# Baza danych i lokalny object storage (wolumen Docker)
DATABASE_PATH=../data/investwatch.db
OBJECT_STORE_DIR=../data/object_store
DATA_DIR=../data

# CORS — adresy frontendu rozdzielone przecinkami
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# Lokalny silnik AI (Ollama na hoście — 100% on-premise, brak płatnych API)
# W Dockerze ustaw: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=25

# Crawler & Anti-SSRF
CRAWLER_TIMEOUT_SECONDS=12
CRAWLER_MAX_BYTES=2097152
CRAWLER_MAX_REDIRECTS=5
CRAWLER_RATE_LIMIT_SECONDS=0.5
CRAWLER_USE_PLAYWRIGHT_FALLBACK=false
CRAWLER_PLAYWRIGHT_TIMEOUT_SECONDS=20
# Strony z mniejszą liczbą znaków widocznego tekstu (bez skryptów) są renderowane przez Playwright
CRAWLER_PLAYWRIGHT_MIN_TEXT_CHARS=400
CRAWLER_ENABLE_SCHEDULER=true
CRAWLER_SCHEDULE_MINUTES=15
# Wyrażenie crontab (UTC); gdy ustawione, zastępuje CRAWLER_SCHEDULE_MINUTES, np. */30 * * * *
CRAWLER_CRON=
# Czy cykliczny skan obejmuje lokalne mock-strony demo (cele z /api/v1/watchlist są skanowane zawsze)
CRAWLER_SCHEDULE_INCLUDE_MOCKS=true
# Rotowane proxy (lista po przecinku), np. http://proxy1:3128,socks5://proxy2:1080; puste = połączenie bezpośrednie
CRAWLER_PROXIES=
# Podobieństwo kosinusowe, powyżej którego ponowny skan tego samego URL aktualizuje istniejący incydent
DEDUP_SIMILARITY_THRESHOLD=0.92

# Docker: obraz z Chromium dla stron renderowanych JS (Playwright, ~400 MB)
INSTALL_PLAYWRIGHT=false
# Docker: wersja obrazu Ollama dla profilu "ai" (docker compose --profile ai up)
OLLAMA_IMAGE_TAG=0.12.6

# Progi alertowania WebSocket (0.00 - 1.00)
HIGH_RISK_ALERT_THRESHOLD=0.65
