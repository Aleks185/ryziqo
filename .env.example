# #InvestWatch — konfiguracja środowiska (bez sekretów w repozytorium)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Port panelu (docker compose: Nginx z frontendem -> http://localhost:3000)
FRONTEND_PORT=3000

# Baza danych i lokalny object storage (wolumen Docker)
DATABASE_PATH=../data/investwatch.db
OBJECT_STORE_DIR=../data/object_store
DATA_DIR=../data

# CORS — adresy frontendu rozdzielone przecinkami
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# Lokalny silnik AI (Ollama na hoście — 100% on-premise, brak płatnych API)
# W Dockerze ustaw: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
# Limit tokenów odpowiedzi (reasoning + sygnały + cytaty) i okno kontekstu modelu
OLLAMA_NUM_PREDICT=768
OLLAMA_NUM_CTX=8192
# Analiza VLM zrzutów ekranu z Playwrighta (wymaga modelu z obsługą obrazów, np. gemma3, qwen2.5vl)
OLLAMA_VISION_ENABLED=false
# Opcjonalnie osobny model VLM; puste = aktywny model, jeśli jest multimodalny
OLLAMA_VISION_MODEL=

# Silnik detekcji AI
# Budżet znaków treści w prompcie (sekcje: nagłówki / treść / klauzule ryzyka i stopka / linki)
AI_PROMPT_CONTENT_CHARS=9000
# Dynamiczne przykłady few-shot (RAG) z incydentów zweryfikowanych przez analityków
AI_RAG_FEW_SHOT_ENABLED=true
# Podobieństwo kosinusowe do potwierdzonego incydentu z innej domeny = klon kampanii
AI_CLONE_SIMILARITY_THRESHOLD=0.85
# Sygnał LLM liczy się tylko, gdy jego cytat występuje w analizowanej treści (Anti-Hallucination Guard)
AI_STRICT_QUOTE_VERIFICATION=true
# primary = jeden incydent na stronę (wykrycia wtórne w evidence_quotes); all_significant = incydent per moduł
AGGREGATOR_MULTI_MODULE_MODE=primary
AGGREGATOR_SECONDARY_MIN_SCORE=0.55

# Crawler & Anti-SSRF
CRAWLER_TIMEOUT_SECONDS=12
CRAWLER_MAX_BYTES=2097152
CRAWLER_MAX_REDIRECTS=5
CRAWLER_RATE_LIMIT_SECONDS=0.5
CRAWLER_USE_PLAYWRIGHT_FALLBACK=false
CRAWLER_PLAYWRIGHT_TIMEOUT_SECONDS=20
# Strony z mniejszą liczbą znaków widocznego tekstu (bez skryptów) są renderowane przez Playwright
CRAWLER_PLAYWRIGHT_MIN_TEXT_CHARS=400
CRAWLER_ENABLE_SCHEDULER=true
CRAWLER_SCHEDULE_MINUTES=15
# Wyrażenie crontab (UTC); gdy ustawione, zastępuje CRAWLER_SCHEDULE_MINUTES, np. */30 * * * *
CRAWLER_CRON=
# Czy cykliczny skan obejmuje lokalne mock-strony demo (cele z /api/v1/watchlist są skanowane zawsze)
CRAWLER_SCHEDULE_INCLUDE_MOCKS=true
# Rotowane proxy (lista po przecinku), np. http://proxy1:3128,socks5://proxy2:1080; puste = połączenie bezpośrednie
CRAWLER_PROXIES=
# Rozwijanie skracaczy (bit.ly, t.co...) i stron link-in-bio (linktr.ee...) do docelowych domen (anty-SSRF na każdym kroku)
CRAWLER_EXPAND_SHORT_LINKS=false
CRAWLER_EXPAND_SHORT_LINKS_MAX=5
# Podobieństwo kosinusowe, powyżej którego ponowny skan tego samego URL aktualizuje istniejący incydent
DEDUP_SIMILARITY_THRESHOLD=0.92
# Etyka crawlera: respektowanie robots.txt (cache per domena) i minimalny odstęp między żądaniami do tego samego hosta
# (większa z wartości: ten parametr albo Crawl-delay z robots.txt, max 30 s)
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_ROBOTS_TTL_HOURS=24
CRAWLER_PER_HOST_DELAY_SECONDS=2
# Startowa watchlista (data/watchlist_seed.json + domeny podmiotów z rejestru KNF), ładowana gdy watchlista jest pusta
WATCHLIST_SEED_ON_START=true

# Odkrywanie nowych treści przez lokalny SearXNG: docker compose --profile discovery up -d
DISCOVERY_ENABLED=false
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=change-me
# Wersja obrazu SearXNG (przypięty tag; aktualizacja: zmień tu i w docker-compose.yml)
SEARXNG_IMAGE_TAG=2026.11.21-c6ee3e9fd
# Crontab (UTC) rundy discovery; każda runda bierze kolejne N zapytań z data/discovery_queries.json
DISCOVERY_CRON=0 */6 * * *
DISCOVERY_QUERIES_PER_RUN=10
DISCOVERY_RESULTS_PER_QUERY=10
DISCOVERY_MAX_NEW_URLS_PER_RUN=20
# URL znaleziony wcześniej nie wraca do kolejki przez tyle dni (cykliczny rescan to zadanie watchlisty)
DISCOVERY_REVISIT_DAYS=7
DISCOVERY_DOMAIN_DENYLIST=knf.gov.pl,gov.pl,wikipedia.org,wikimedia.org,google.com,bing.com,duckduckgo.com,europa.eu,esma.europa.eu,gpw.pl,nbp.pl

# Odświeżanie snapshotu rejestru KNF z oficjalnych list knf.gov.pl (crontab UTC, puste = wyłączone), np. 0 3 * * 1
KNF_REFRESH_CRON=

# Docker: obraz z Chromium dla stron renderowanych JS (Playwright, ~400 MB)
INSTALL_PLAYWRIGHT=false
# Docker: wersja obrazu Ollama dla profilu "ai" (docker compose --profile ai up)
OLLAMA_IMAGE_TAG=0.12.6

# Progi alertowania WebSocket (0.00 - 1.00)
HIGH_RISK_ALERT_THRESHOLD=0.65
