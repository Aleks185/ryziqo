# #InvestWatch — konfiguracja frontendu (CRA wkleja zmienne REACT_APP_* do bundla w czasie BUILDU)
# Skopiuj do frontend/.env dla dev lokalnego: cp .env.example .env

# Adres API backendu. Dev lokalny: pełny URL. W Dockerze (Nginx proxy): ścieżka relatywna /api/v1
REACT_APP_INVESTWATCH_API_URL=http://localhost:8000/api/v1

# Próg ryzyka (0.00–1.00), od którego frontend pokazuje alert
REACT_APP_ALERT_THRESHOLD=0.7

# Dev server CRA
ENABLE_HEALTH_CHECK=false
